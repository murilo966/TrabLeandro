
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lumber Tycoon 2 - Catálogo de Machados</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f2f4f7;
            color: #333;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        h1, h2 {
            color: #294b35;
        }

        .painel {
            background: white;
            padding: 22px;
            border-radius: 8px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .campo {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .campo.completo {
            grid-column: 1 / -1;
        }

        input, select, textarea {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            width: 100%;
        }

        textarea {
            resize: vertical;
            min-height: 75px;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .salvar {
            background: #347a49;
            color: white;
        }

        .limpar {
            background: #ddd;
            color: #333;
        }

        .editar {
            background: #e5a832;
            color: #222;
            margin-right: 5px;
        }

        .excluir {
            background: #c94b4b;
            color: white;
        }

        .pesquisa {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .pesquisa input {
            flex: 1;
        }

        .tabela-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            min-width: 900px;
        }

        th, td {
            border-bottom: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background: #e8efe9;
            color: #294b35;
        }

        tr:hover {
            background: #f7f9f7;
        }

        .mensagem {
            margin-top: 12px;
            font-weight: bold;
        }

        @media (max-width: 650px) {
            body {
                padding: 15px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .campo.completo {
                grid-column: auto;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Lumber Tycoon 2</h1>
    <p>Catálogo e gerenciamento de machados.</p>

    <!-- FORMULÁRIO -->
    <section class="painel">

        <h2 id="titulo-formulario">Cadastrar Machado</h2>

        <form id="form-machado">

            <input type="hidden" id="id_machado">

            <div class="form-grid">

                <div class="campo">
                    <label for="nome_machado">Nome do Machado *</label>
                    <input type="text" id="nome_machado" required>
                </div>

                <div class="campo">
                    <label for="preco">Preço</label>
                    <input type="number" id="preco" min="0" step="0.01">
                </div>

                <div class="campo">
                    <label for="id_categoria">Categoria *</label>
                    <select id="id_categoria" required>
                        <option value="">Carregando categorias...</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="id_raridade">Raridade *</label>
                    <select id="id_raridade" required>
                        <option value="">Carregando raridades...</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="local_obtencao">Local de obtenção</label>
                    <input type="text" id="local_obtencao">
                </div>

                <div class="campo">
                    <label for="madeira_eficiencia">Madeira / Eficiência</label>
                    <input type="text" id="madeira_eficiencia">
                </div>

                <div class="campo completo">
                    <label for="descricao">Descrição</label>
                    <textarea id="descricao"></textarea>
                </div>

            </div>

            <br>

            <button type="submit" class="salvar">Salvar Machado</button>
            <button type="button" class="limpar" onclick="limparFormulario()">
                Limpar
            </button>

            <div id="mensagem" class="mensagem"></div>

        </form>

    </section>

    <!-- LISTAGEM -->
    <section class="painel">

        <h2>Machados cadastrados</h2>

        <div class="pesquisa">
            <input
                type="text"
                id="pesquisa"
                placeholder="Pesquisar por nome, categoria, raridade ou local..."
            >
            <button type="button" class="limpar" onclick="limparPesquisa()">
                Limpar pesquisa
            </button>
        </div>

        <p id="contador">Carregando machados...</p>

        <div class="tabela-container">

            <table>

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Machado</th>
                        <th>Categoria</th>
                        <th>Raridade</th>
                        <th>Preço</th>
                        <th>Local</th>
                        <th>Madeira / Eficiência</th>
                        <th>Descrição</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody id="tabela-machados">
                    <tr>
                        <td colspan="9">Carregando...</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </section>

</div>

<script>

    let listaMachados = [];

    // Escapar conteúdo antes de inserir no HTML
    function escaparHTML(valor) {
        return String(valor ?? '').replace(/[&<>"']/g, function (caractere) {
            const entidades = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };

            return entidades[caractere];
        });
    }

    // Requisição padrão para as APIs
    async function requisicao(url, opcoes = {}) {

        const resposta = await fetch(url, opcoes);

        const dados = await resposta.json().catch(() => ({}));

        if (!resposta.ok) {
            throw new Error(dados.detalhe || dados.erro || 'Erro na requisição.');
        }

        return dados;
    }

    // Carregar categorias
    async function carregarCategorias() {

        const categorias = await requisicao('/api/categorias');

        const select = document.getElementById('id_categoria');

        select.innerHTML = '<option value="">Selecione uma categoria</option>';

        categorias.forEach(categoria => {

            select.innerHTML += `
                <option value="${categoria.id_categoria}">
                    ${escaparHTML(categoria.nome_categoria)}
                </option>
            `;

        });
    }

    // Carregar raridades
    async function carregarRaridades() {

        const raridades = await requisicao('/api/raridades');

        const select = document.getElementById('id_raridade');

        select.innerHTML = '<option value="">Selecione uma raridade</option>';

        raridades.forEach(raridade => {

            select.innerHTML += `
                <option value="${raridade.id_raridade}">
                    ${escaparHTML(raridade.nome_raridade)}
                </option>
            `;

        });
    }

    // Buscar machados
    async function carregarMachados() {

        const tabela = document.getElementById('tabela-machados');

        try {

            tabela.innerHTML = '<tr><td colspan="9">Carregando...</td></tr>';

            listaMachados = await requisicao('/api/machados');

            renderizarMachados(listaMachados);

        } catch (erro) {

            console.error('Erro ao buscar machados:', erro);

            tabela.innerHTML = `
                <tr>
                    <td colspan="9">
                        Erro ao buscar machados: ${escaparHTML(erro.message)}
                    </td>
                </tr>
            `;

            document.getElementById('contador').textContent =
                'Não foi possível carregar os machados.';
        }
    }

    // Exibir machados na tabela
    function renderizarMachados(machados) {

        const tabela = document.getElementById('tabela-machados');

        document.getElementById('contador').textContent =
            `${machados.length} machado(s) encontrado(s).`;

        if (machados.length === 0) {

            tabela.innerHTML = `
                <tr>
                    <td colspan="9">Nenhum machado encontrado.</td>
                </tr>
            `;

            return;
        }

        tabela.innerHTML = machados.map(m => {

            const preco = m.preco == null
                ? 'Não informado'
                : Number(m.preco).toFixed(2);

            return `
                <tr>
                    <td>${m.id_machado}</td>
                    <td>${escaparHTML(m.nome_machado)}</td>
                    <td>${escaparHTML(m.nome_categoria || 'Não informado')}</td>
                    <td>${escaparHTML(m.nome_raridade || 'Não informado')}</td>
                    <td>${preco}</td>
                    <td>${escaparHTML(m.local_obtencao)}</td>
                    <td>${escaparHTML(m.madeira_eficiencia)}</td>
                    <td>${escaparHTML(m.descricao)}</td>

                    <td>
                        <button
                            class="editar"
                            onclick="editarMachado(${m.id_machado})">
                            Editar
                        </button>

                        <button
                            class="excluir"
                            onclick="deletarMachado(${m.id_machado})">
                            Excluir
                        </button>
                    </td>
                </tr>
            `;

        }).join('');
    }

    // Pesquisar machados
    document.getElementById('pesquisa').addEventListener('input', function () {

        const termo = this.value.toLowerCase().trim();

        const filtrados = listaMachados.filter(m => {

            const texto = [
                m.nome_machado,
                m.nome_categoria,
                m.nome_raridade,
                m.local_obtencao,
                m.madeira_eficiencia,
                m.descricao
            ].join(' ').toLowerCase();

            return texto.includes(termo);

        });

        renderizarMachados(filtrados);
    });

    // Limpar pesquisa
    function limparPesquisa() {

        document.getElementById('pesquisa').value = '';

        renderizarMachados(listaMachados);
    }

    // Limpar formulário
    function limparFormulario() {

        document.getElementById('form-machado').reset();

        document.getElementById('id_machado').value = '';

        document.getElementById('titulo-formulario').textContent =
            'Cadastrar Machado';

        document.getElementById('mensagem').textContent = '';
    }

    // Editar machado
    function editarMachado(id) {

        const machado = listaMachados.find(m => m.id_machado === id);

        if (!machado) {
            alert('Machado não encontrado.');
            return;
        }

        document.getElementById('id_machado').value = machado.id_machado;
        document.getElementById('nome_machado').value = machado.nome_machado;
        document.getElementById('id_categoria').value = machado.id_categoria;
        document.getElementById('id_raridade').value = machado.id_raridade;
        document.getElementById('preco').value = machado.preco ?? '';
        document.getElementById('local_obtencao').value = machado.local_obtencao ?? '';
        document.getElementById('madeira_eficiencia').value = machado.madeira_eficiencia ?? '';
        document.getElementById('descricao').value = machado.descricao ?? '';

        document.getElementById('titulo-formulario').textContent =
            'Editar Machado';

        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    }

    // Excluir machado
    async function deletarMachado(id) {

        if (!confirm('Deseja realmente excluir este machado?')) {
            return;
        }

        try {

            const resultado = await requisicao(`/api/machados/${id}`, {
                method: 'DELETE'
            });

            alert(resultado.mensagem);

            await carregarMachados();

        } catch (erro) {

            alert('Erro ao excluir: ' + erro.message);

        }
    }

    // Cadastrar ou atualizar machado
    document.getElementById('form-machado').addEventListener('submit', async function (evento) {

        evento.preventDefault();

        const id = document.getElementById('id_machado').value;

        const dados = {
            nome_machado: document.getElementById('nome_machado').value.trim(),
            id_categoria: document.getElementById('id_categoria').value,
            id_raridade: document.getElementById('id_raridade').value,
            preco: document.getElementById('preco').value,
            local_obtencao: document.getElementById('local_obtencao').value.trim(),
            madeira_eficiencia: document.getElementById('madeira_eficiencia').value.trim(),
            descricao: document.getElementById('descricao').value.trim()
        };

        try {

            const resultado = await requisicao(
                id ? `/api/machados/${id}` : '/api/machados',
                {
                    method: id ? 'PUT' : 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(dados)
                }
            );

            document.getElementById('mensagem').textContent =
                resultado.mensagem;

            limparFormulario();
            limparPesquisa();

            await carregarMachados();

        } catch (erro) {

            document.getElementById('mensagem').textContent =
                'Erro: ' + erro.message;

            console.error('Erro ao salvar machado:', erro);
        }
    });

    // Inicialização
    async function iniciarAplicacao() {

        try {

            await carregarCategorias();
            await carregarRaridades();
            await carregarMachados();

        } catch (erro) {

            console.error('Erro ao inicializar aplicação:', erro);

            document.getElementById('contador').textContent =
                'Erro ao carregar os dados iniciais: ' + erro.message;
        }
    }

    iniciarAplicacao();

</script>

</body>
</html>
