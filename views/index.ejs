
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <title>Bestiário - Bloodborne</title>

    <style>
      body { font-family: Arial, sans-serif; margin: 40px; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 3px solid #ccc; padding: 10px; text-align: center; }
      th { background: #f0f0f0; }
    </style>
  </head>
  <body>

    <div id="mensagem"></div>

    <h2 id="titulo-form">Nova criatura</h2>

    <form id="form-criatura">
      <input type="hidden" id="id_criatura">

      <label>Nome
        <input type="text" id="nome" required>
      </label>

      <label>Localização
        <input type="text" id="localizacao" required>
      </label>

      <label>Ecos
        <input type="number" id="ecos" required>
      </label>

      <label>Fraqueza
        <select id="id_fraqueza" required>
          <option value="">Selecione a fraqueza</option>
          <option value="1">Físico</option>
          <option value="2">Cortante</option>
          <option value="3">Arcano</option>
          <option value="4">Fogo</option>
          <option value="5">Elétrico</option>
        </select>
      </label>

      <label>Status
        <select id="id_status" required>
          <option value="">Selecione o status</option>
          <option value="1">Derrotado(a)</option>
          <option value="2">Não Derrotado(a)</option>
        </select>
      </label>

      <div class="botoes">
        <button type="submit" id="btn-salvar">Salvar</button>
      </div>
    </form>

    <h2>Pesquisar registro</h2>

    <form id="form-pesquisa">
      <label>
        Nome ou localização
        <input
          type="text"
          id="pesquisa"
          placeholder="Pesquisar criatura..."
        >
      </label>

      <button type="submit">Pesquisar</button>

      <button
        type="button"
        onclick="limparPesquisa()"
      >
        Limpar
      </button>
    </form>

    <h1>Bestiário de Bloodborne</h1>

    <p id="contador">0 registro(s)</p>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>Localização</th>
          <th>Ecos</th>
          <th>Fraqueza</th>
          <th>Status</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody id="tabela-criaturas"></tbody>
    </table>

    <script>

      let listaCriaturas = [];

      async function carregarCriaturas() {
        const tbody = document.getElementById('tabela-criaturas');

        try {
          const resposta = await fetch('/api/bestiario');
          const criaturas = await resposta.json();

          if (!resposta.ok) {
            throw new Error(criaturas.erro);
          }

          listaCriaturas = criaturas;

          renderizarCriaturas(listaCriaturas);

        } catch (erro) {
          tbody.innerHTML = `<tr><td colspan="7">${erro.message}</td></tr>`;
          document.getElementById('contador').textContent = '0 registro(s)';
        }
      }

      function renderizarCriaturas(criaturas) {
        const tbody = document.getElementById('tabela-criaturas');
        const contador = document.getElementById('contador');

        contador.textContent = `${criaturas.length} registro(s)`;

        if (criaturas.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7">Nenhum registro encontrado.</td>
            </tr>`;
          return;
        }

        tbody.innerHTML = criaturas.map(c => `
          <tr>
            <td>${c.id_criatura}</td>
            <td>${c.nome}</td>
            <td>${c.localizacao}</td>
            <td>${c.ecos}</td>
            <td>${c.nome_fraqueza}</td>
            <td>${c.nome_status}</td>
            <td>
              <button onclick="editarCriatura(${c.id_criatura})">Editar</button>
              <button onclick="deletarCriatura(${c.id_criatura})">Deletar</button>
            </td>
          </tr>`).join('');
      }

      carregarCriaturas();

      // PESQUISAR CRIATURAS

      document.getElementById('form-pesquisa').addEventListener('submit', (evento) => {
        evento.preventDefault();

        const termo = document.getElementById('pesquisa').value.trim().toLowerCase();

        const criaturasFiltradas = listaCriaturas.filter(c =>
          c.nome.toLowerCase().includes(termo) ||
          c.localizacao.toLowerCase().includes(termo)
        );

        renderizarCriaturas(criaturasFiltradas);
      });

      // LIMPAR PESQUISA

      function limparPesquisa() {
        document.getElementById('pesquisa').value = '';
        renderizarCriaturas(listaCriaturas);
      }

      // EDITAR CRIATURA

      function editarCriatura(id) {
        const c = listaCriaturas.find(criatura => criatura.id_criatura == id);

        if (!c) return;

        document.getElementById('id_criatura').value = c.id_criatura;
        document.getElementById('nome').value = c.nome;
        document.getElementById('localizacao').value = c.localizacao;
        document.getElementById('ecos').value = c.ecos;
        document.getElementById('id_fraqueza').value = c.id_fraqueza;
        document.getElementById('id_status').value = c.id_status;

        document.getElementById('titulo-form').textContent = 'Editar criatura';

        window.scrollTo(0, 0);
      }

      // DELETAR CRIATURA

      async function deletarCriatura(id) {
        if (!confirm('Deseja realmente deletar esta criatura?')) {
          return;
        }

        const resposta = await fetch(`/api/bestiario/${id}`, {
          method: "DELETE"
        });

        if (resposta.ok) {
          alert("Criatura excluída!");
          carregarCriaturas();
        } else {
          alert("Erro ao excluir criatura.");
        }
      }

      // CADASTRAR / ATUALIZAR CRIATURA

      document.getElementById('form-criatura').addEventListener('submit', async (evento) => {
        evento.preventDefault();

        const id = document.getElementById('id_criatura').value;

        const criatura = {
          nome: document.getElementById('nome').value,
          localizacao: document.getElementById('localizacao').value,
          ecos: document.getElementById('ecos').value,
          id_fraqueza: document.getElementById('id_fraqueza').value,
          id_status: document.getElementById('id_status').value,
        };

        const metodo = id ? 'PUT' : 'POST';
        const endereco = id ? '/api/bestiario/' + id : '/api/bestiario';

        const resposta = await fetch(endereco, {
          method: metodo,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(criatura)
        });

        const resultado = await resposta.json();

        document.getElementById('mensagem').textContent =
          resultado.mensagem ?? resultado.erro;

        if (resposta.ok) {
          document.getElementById('form-criatura').reset();
          document.getElementById('id_criatura').value = '';
          document.getElementById('titulo-form').textContent = 'Nova criatura';

          // Recarrega a lista e limpa a pesquisa
          limparPesquisa();
          carregarCriaturas();
        }
      });

    </script>

  </body>
</html>
